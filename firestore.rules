rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'prosanta97348963@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Users collection (Salesmen profiles)
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Customers collection
    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Products collection
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.salesmanUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.salesmanUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        incoming().salesmanUid == request.auth.uid &&
        incoming().status == 'NEW' &&
        incoming().totalAmount >= 0;
      allow update: if isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'notes']);
      allow delete: if false;
    }
  }
}
